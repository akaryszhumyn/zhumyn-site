---
import '../design-system/tokens.css';
import { langs, localize, ogLocale, SECTION, t, type Lang } from '../i18n';
import Header from '../design-system/components/Header.astro';
import Footer from '../design-system/components/Footer.astro';
import DotsBackground from '../design-system/components/DotsBackground.astro';

interface Props {
  lang: Lang;
  /** Путь без языкового префикса, например '/cases/' */
  path: string;
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Языки, на которых эта страница существует (по умолчанию все) */
  alternates?: Lang[];
  /** Раздел сайта: '/product' (по умолчанию) или '' для главной */
  section?: string;
  /** Свои пункты меню (для главной); без них меню портфолио */
  nav?: { href: string; label: string }[];
}
const { lang, path, title, description, image, noindex = false, alternates = [...langs], section = SECTION, nav } = Astro.props;
const s = t(lang);
const fullTitle = title ? `${title} — ${s.meta.siteName}` : s.meta.siteName;
const desc = description ?? s.meta.description;
const url = (l: Lang) => new URL(localize(l, path, section), Astro.site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/MedeoSansVariable.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>try{var t=localStorage.getItem('theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.dataset.theme=t}catch(e){}</script>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : (
      <>
        <link rel="canonical" href={url(lang)} />
        {alternates.map((l) => <link rel="alternate" hreflang={l} href={url(l)} />)}
        <link rel="alternate" hreflang="x-default" href={url(alternates.includes('kk') ? 'kk' : alternates[0])} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url(lang)} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {alternates.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    {image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <DotsBackground />
    <a class="skip-link" href="#main">{s.skip}</a>
    <Header lang={lang} path={path} alternates={alternates} section={section} nav={nav} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
