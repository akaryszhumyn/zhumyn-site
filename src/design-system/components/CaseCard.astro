---
import { Picture } from 'astro:assets';
import { localize, t, type Lang } from '../../i18n';
import type { CaseEntry } from '../../lib/cases';
import Tag from './Tag.astro';
interface Props { entry: CaseEntry; lang: Lang; eager?: boolean }
const { entry, lang, eager = false } = Astro.props;
const d = entry.data;
---
<article class="case-card">
  <a class="case-card__link" href={localize(lang, `/cases/${entry.slug}/`)}>
    <Picture
      pictureAttributes={{ class: 'reveal' }}
      class="case-card__cover"
      src={d.cover}
      alt={d.coverAlt}
      formats={['avif', 'webp']}
      widths={[400, 720, 1080]}
      sizes="(min-width: 72rem) 34rem, (min-width: 44rem) 50vw, 100vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
    />
    <div class="case-card__body">
      <p class="case-card__meta">{d.company} · {d.period}</p>
      <h3 class="case-card__title">{d.title}</h3>
      <p class="case-card__summary">{d.summary}</p>
      {d.tags.length > 0 && <div class="case-card__tags">{d.tags.map((tag) => <Tag>{tag}</Tag>)}</div>}
      <span class="visually-hidden">{t(lang).cases.read}</span>
    </div>
  </a>
</article>
<style>
  .case-card__link { display: grid; gap: var(--space-4); color: inherit; text-decoration: none; }
  .case-card__link :global(img) {
    width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius-card);
    background: var(--color-surface);
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .case-card__link:hover :global(img) { transform: scale(1.015); }
  .case-card__body { display: grid; gap: var(--space-2); }
  .case-card__meta { font-size: var(--text-sm); color: var(--color-text-muted); }
  .case-card__title { font-size: var(--text-lg); }
  .case-card__summary { color: var(--color-text-muted); }
  .case-card__tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-1); }
</style>
