---
// Кнопка: подпись и квадратная плитка с точечной иконкой (как на старом сайте).
// Для внешних ссылок (http…) иконка «звено» и открытие в новой вкладке, иначе стрелка.
interface Props { href?: string; variant?: 'primary' | 'secondary'; type?: 'button' | 'submit' }
const { href, variant = 'primary', type = 'button' } = Astro.props;
const Tag = href ? 'a' : 'button';
const external = !!href && /^https?:/.test(href);
---
<Tag
  class:list={['btn', `btn--${variant}`, { 'btn--external': external }]}
  href={href}
  type={href ? undefined : type}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
>
  <span class="btn__label"><slot /></span>
  <span class="btn__icon" aria-hidden="true"></span>
</Tag>
<style>
  .btn {
    --icon: url('/icons/arrow-dots.svg');
    display: inline-flex; align-items: center; gap: var(--space-4);
    padding: 0.375rem 0.375rem 0.375rem var(--space-5); border-radius: var(--radius-control);
    font: inherit; font-size: var(--text-sm); font-weight: var(--weight-medium);
    text-decoration: none; cursor: pointer; border: 0;
    transition: transform var(--duration-fast) var(--ease-out);
  }
  .btn--external { --icon: url('/icons/link-dots.svg'); }
  .btn:active { transform: scale(0.97); }
  .btn--primary { background: var(--color-text); color: var(--color-bg); --tile: var(--color-bg); --dots: var(--color-text); }
  .btn--secondary { background: var(--color-surface); color: var(--color-text); --tile: var(--color-text); --dots: var(--color-bg); }
  /* При наведении плитка становится акцентной (синей) */
  .btn:hover { --tile: var(--color-accent); --dots: var(--color-accent-contrast); }

  .btn__icon {
    position: relative; flex: none; width: 2.5rem; height: 2.5rem;
    border-radius: calc(var(--radius-control) - 0.375rem); background: var(--tile);
    transition: background var(--duration-base) var(--ease-out);
  }
  /* Точки рисуем маской, чтобы они брали нужный цвет в любой теме */
  .btn__icon::before {
    content: ''; position: absolute; inset: 0; background: var(--dots);
    mask: var(--icon) center / 100% no-repeat;
    transition: background var(--duration-base) var(--ease-out);
  }
</style>
