---
import { t, type Lang } from '../../i18n';
interface Props { lang: Lang }
const s = t(Astro.props.lang);
---
<!-- Сегментный переключатель: серая подложка, активный сегмент белая «пилюля» -->
<div class="theme" role="group" aria-label={s.themeLabel}>
  <span class="theme__pill" aria-hidden="true"></span>
  <button type="button" data-theme="light" aria-label={s.themeLight} aria-pressed="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
  <button type="button" data-theme="dark" aria-label={s.themeDark} aria-pressed="false">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
  </button>
</div>
<style>
  .theme {
    --seg: 2.25rem; position: relative; display: inline-flex; padding: 4px;
    background: var(--color-track); border-radius: var(--radius-control);
  }
  .theme__pill {
    position: absolute; top: 4px; left: 4px; width: var(--seg); height: var(--seg);
    background: var(--color-pill); border-radius: calc(var(--radius-control) - 4px); box-shadow: var(--shadow-sm);
    transition: transform var(--duration-slow) var(--ease-out);
  }
  /* Состояние берётся из <html data-theme>, оно выставляется до первой отрисовки, поэтому пилюля не «подъезжает» при загрузке */
  :global(:root[data-theme='dark']) .theme__pill { transform: translateX(100%); }
  button {
    position: relative; display: grid; place-items: center; width: var(--seg); height: var(--seg);
    padding: 0; border: 0; background: none; cursor: pointer; color: var(--color-text-muted);
    transition: color var(--duration-slow) var(--ease-out);
  }
  :global(:root[data-theme='light']) button[data-theme='light'],
  :global(:root[data-theme='dark']) button[data-theme='dark'] { color: var(--color-text); }
  svg { width: 1rem; height: 1rem; }
</style>
<script>
  const group = document.querySelector<HTMLElement>('.theme')!;
  const buttons = group.querySelectorAll<HTMLButtonElement>('button');
  const root = document.documentElement;
  const system = matchMedia('(prefers-color-scheme: dark)');
  const saved = () => { try { return localStorage.getItem('theme'); } catch { return null; } };

  const sync = () => {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.theme === root.dataset.theme)));
    dispatchEvent(new Event('themechange')); // фон из точек перекрашивается
  };
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      root.dataset.theme = b.dataset.theme;
      try { localStorage.setItem('theme', b.dataset.theme!); } catch {}
      sync();
    }),
  );
  // пока пользователь не выбрал вручную, следуем за системой
  system.addEventListener('change', () => {
    if (!saved()) root.dataset.theme = system.matches ? 'dark' : 'light';
    sync();
  });
  sync();
</script>
