---
import { t, type Lang } from '../../i18n';
import { contacts } from '../../site';
import Link from './Link.astro';
interface Props { lang: Lang; title?: string; lead?: string; heading?: 'h1' | 'h2' }
const { lang, heading: Heading = 'h2' } = Astro.props;
const { title = t(lang).contacts.blockTitle, lead = t(lang).contacts.lead } = Astro.props;
---
<div class="contact">
  <Heading class="contact__title">{title}</Heading>
  <p class="contact__lead">{lead}</p>
  <ul class="contact__list">
    <li><Link href={contacts.telegram}>Telegram</Link></li>
    <li><Link href={contacts.whatsapp}>WhatsApp</Link></li>
    <li><Link href={contacts.linkedin}>LinkedIn</Link></li>
    <li><Link href={contacts.behance}>Behance</Link></li>
    <li><Link href={contacts.instagram}>Instagram</Link></li>
  </ul>
</div>
<style>
  .contact { display: grid; gap: var(--space-4); padding: var(--space-7) var(--space-5); border-radius: var(--radius-lg); background: var(--color-surface); }
  .contact__title { font-size: var(--text-xl); }
  .contact__lead { color: var(--color-text-muted); max-width: 36rem; }
  .contact__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-5); font-size: var(--text-lg); }
</style>
